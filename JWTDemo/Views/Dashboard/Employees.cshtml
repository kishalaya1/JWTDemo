@model IEnumerable<EmployeeViewModel>
@{
    ViewData["Title"] = "Employee Data";
}
<h1>Employee Data</h1>
<p class="text-muted">Visible to Admin users.</p>
<table class="table table-striped table-bordered">
    <thead><tr><th>Name</th><th>Age</th><th>Gender</th><th>E-mail id</th></tr></thead>
    <tbody>
    @foreach (var employee in Model)
    {
        <tr><td>@employee.Name</td><td>@employee.Age</td><td>@employee.Gender</td><td>@employee.Email</td></tr>
    }
    </tbody>
</table>
