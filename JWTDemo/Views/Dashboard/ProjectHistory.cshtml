@model IEnumerable<ProjectHistoryViewModel>
@{
    ViewData["Title"] = "Project Worked On History";
}
<h1>Project Worked On History</h1>
<p class="text-muted">Visible to all authenticated users.</p>
<table class="table table-striped table-bordered">
    <thead><tr><th>Employee</th><th>Project name</th><th>Role</th><th>Completed date</th></tr></thead>
    <tbody>
    @foreach (var project in Model)
    {
        <tr><td>@project.EmployeeName</td><td>@project.ProjectName</td><td>@project.Role</td><td>@project.CompletedDate</td></tr>
    }
    </tbody>
</table>
