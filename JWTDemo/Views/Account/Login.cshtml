@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1>Sign in</h1>
        <p class="text-muted">Use one of the demo users to access the JWT-protected landing page.</p>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary">Sign in</button>
        </form>
        <hr />
        <small class="text-muted">Examples: admin.one / Admin123!, manager.one / Manager123!, superuser.one / Super123!, minor.one / Minor123!</small>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
